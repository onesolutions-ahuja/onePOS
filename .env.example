# onePOS environment variables - EXAMPLE / PLACEHOLDERS ONLY.
#
# Copy this file to `.env` for local development and fill in real values there.
# `.env` is git-ignored - never commit real credentials or API keys.

# PostgreSQL connection string
DATABASE_URL=

# HTTP port (Render sets this automatically in production)
PORT=10000

# Secret used to sign onePOS session JWTs
JWT_SECRET=

# ---------------------------------------------------------------------------
# JARVIS AI assistant (server-side only)
# ---------------------------------------------------------------------------
# Google Gemini API key used by the JARVIS assistant.
# - Server-side ONLY. It is read by services/jarvis/providers/geminiProvider.js.
# - NEVER paste it into frontend code, and NEVER use a VITE_ prefix: Vite
#   inlines VITE_* variables into the browser bundle.
GEMINI_API_KEY=

# Optional: which AI provider JARVIS uses (default: gemini).
# `gemini` is the only provider implemented in V1; adding another provider is
# a new factory in services/jarvis/providers/index.js.
JARVIS_AI_PROVIDER=gemini

# Optional: Gemini model override. Empty = the built-in default
# (`gemini-flash-latest`, an alias Google hot-swaps to the newest Flash model).
# Pin a version for predictable latency/behaviour, e.g. gemini-3.6-flash or a
# Flash-Lite model. Current Gemini 3 models think before answering (on by
# default), which makes `-latest` latency unpredictable.
JARVIS_GEMINI_MODEL=

# Optional: provider request timeout in milliseconds (default: 45000).
# Needs headroom for a thinking model; too small a value aborts valid
# questions and the till sees `provider_timeout` (504).
JARVIS_AI_TIMEOUT_MS=
